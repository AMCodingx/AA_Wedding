---
import PageLayout from '~/layouts/PageLayout.astro';
import FAQ from '~/features/wedding/FAQ.astro';
import { useTranslations } from '~/i18n';

const locale = 'es' as const;
const t = useTranslations(locale);
---

{/* No Section wrapper: FAQ is a full-bleed card that carries its own
    gradient and its own measure, exactly like the other three. */}
<PageLayout
  locale={locale}
  routeKey="faq"
  title={t('wedding.faq.title')}
  description={t('wedding.faq.intro')}
>
  <FAQ locale={locale} />
</PageLayout>
