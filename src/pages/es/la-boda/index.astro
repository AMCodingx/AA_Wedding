---
import PageLayout from '~/layouts/PageLayout.astro';
import TheDay from '~/features/wedding/TheDay.astro';
import { useTranslations } from '~/i18n';

const locale = 'es' as const;
const t = useTranslations(locale);
---

<PageLayout
  locale={locale}
  routeKey="wedding"
  showFooter={false}
  title={t('wedding.title')}
  description={t('wedding.day.intro')}
>
  <TheDay locale={locale} />
</PageLayout>
