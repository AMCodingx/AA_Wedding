---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Card from './Card.astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  title: string;
  loading?: 'lazy' | 'eager';
  /** object-position for the cover crop (e.g. '50% 25%') — lets a consumer
      slide the 16:10 window up or down a photo so faces stay in frame. */
  position?: string;
  class?: string;
}

const { image, alt, title, loading = 'lazy', position, class: className = '' } = Astro.props;
const hasBadge = Astro.slots.has('badge');
---

<Card elevation="lift" as="article" class={`image-card ${className}`.trim()}>
  <div class="image-card__media">
    <Image
      src={image}
      alt={alt}
      widths={[400, 800]}
      sizes="(min-width: 900px) 33vw, (min-width: 600px) 50vw, 100vw"
      format="avif"
      quality={80}
      loading={loading}
      decoding="async"
      class="image-card__img"
      style={position && `object-position: ${position}`}
    />
  </div>

  <div class="image-card__header">
    {/* h2, not h3: the only consumer (Tips) puts these directly under the
        page h1 — the filter groups the cards, but it isn't a heading, so an h3
        here skips a level. Take a `level` prop if a second consumer ever nests
        these deeper. */}
    <h2 class="image-card__title">{title}</h2>
    {hasBadge && (
      <div class="image-card__tag">
        <slot name="badge" />
      </div>
    )}
  </div>

  <div class="image-card__body">
    <slot />
  </div>
</Card>

<style>
  .image-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .image-card__media {
    margin: calc(-1 * var(--space-6)) calc(-1 * var(--space-6)) var(--space-4);
    border-radius: var(--radius-lg) var(--radius-lg) var(--radius-md) var(--radius-md);
    overflow: hidden;
    aspect-ratio: 16 / 10;
    /* Hairline so a photo with a pale edge still has a shape. Outline, not
       border: it paints over the image and doesn't take part in layout, so
       the media keeps sitting flush on the card's own corners. */
    outline: 1px solid var(--outline-image);
    outline-offset: -1px;
  }

  .image-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--dur-base) var(--ease-out);
  }

  .image-card:hover .image-card__img {
    transform: scale(1.04);
  }

  /* Title left, tag pinned right on the same row. The tag is icon-only now,
     so it always fits beside the title — no wrap release valve needed. */
  .image-card__header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-block-end: var(--space-2);
  }

  .image-card__tag {
    flex: none;
    margin-inline-start: auto;
  }

  /* The subtitle treatment (Poppins 600 — what h4 wears), not the display
     face. The hero and The day keep the script for the one title on the
     page and set everything under it in Poppins; at --fs-base the script's
     x-height also left these reading lighter than the blurb below them. */
  .image-card__title {
    font-family: var(--font-subtitle);
    font-weight: var(--weight-subtitle);
    font-size: var(--fs-base);
    letter-spacing: 0.01em;
    margin: 0;
    line-height: 1.2;
    color: var(--c-lagoon);
    text-wrap: balance;
  }

  /* Lagoon, not the muted grey: the card system paints every piece of copy
     in the one colour and lets size and face carry the hierarchy. 400 rather
     than the ExtraLight page default, matching The day. */
  .image-card__body {
    color: var(--c-lagoon);
    /* Consumers on the card system override this with a card-relative size by
       setting --card-body-fs on any ancestor, the way they repaint the ground
       with --card-bg. The component stays dumb. */
    font-size: var(--card-body-fs, var(--fs-sm));
    font-weight: 400;
    line-height: 1.6;
  }

  .image-card__body :global(p) {
    margin: 0;
    /* inherit, not a value: typography.css's bare `p { font-size: var(--fs-base) }`
       outranks inheritance from the body, so the card-relative size set above
       never reached the blurb without this. */
    font-size: inherit;
    text-wrap: pretty;
  }

  @media (prefers-reduced-motion: reduce) {
    .image-card__img {
      transition: none;
    }
  }
</style>
