---
interface Props {
  tone?: 'sea' | 'sand' | 'mist' | 'outline' | 'bare';
  class?: string;
}

const { tone = 'sea', class: className = '' } = Astro.props;
---

<span class:list={['badge', `badge--${tone}`, className]}>
  <slot />
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    font-family: var(--font-subtitle);
    font-size: var(--fs-xs);
    font-weight: var(--weight-subtitle);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1.2;
    border: 1px solid transparent;
    /* One ink for every tone — the wash tells you which category, the
       lettering stays the card system's lagoon. Clears AA on all four
       grounds (5.25:1 on sea, 6.12:1 on sand, 6.14:1 on mist, 8.5:1 on the
       card's white behind the outline tone). */
    color: var(--c-lagoon);
  }
  .badge--sea {
    background: var(--accent-soft);
  }
  .badge--sand {
    background: var(--warm);
  }
  .badge--mist {
    background: var(--surface);
  }
  .badge--outline {
    background: transparent;
    border-color: var(--c-tide);
  }
  /* No pill at all — the mark and the word, sitting in the type. On a card the
     ring around this was a second rounded rectangle inside the card's own, and
     two nested pills on a 340px column read as chrome rather than as a label.

     Sentence case at the body weight, not the tracked caps the filled tones
     wear. Two reasons, and they point the same way: the caps ran ~40% wider
     than the words themselves, which pushed Dutch "Bezienswaardigheden" off
     the title's line on 16 of 22 cards — and quiet is the whole point of this
     tone. Ink stays lagoon; --c-tide-deep is only 2.94:1 on the tips cards'
     --c-shallow ground and would fail at this size. */
  .badge--bare {
    background: transparent;
    border: 0;
    padding: 0;
    font-weight: 400;
    letter-spacing: 0.01em;
    text-transform: none;
    white-space: nowrap;
  }
</style>
