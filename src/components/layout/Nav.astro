---
import { useTranslations, type Locale } from '~/i18n';
import { href, type RouteKey } from '~/lib/url';
// Each label is the destination page's own title, in the card's hand — the
// same outlined "Feeling Passionate" vector the page shows in its <h1>, not a
// webfont approximation of it. RSVP is the tail of the RSVP card's TO RSVP,
// sliced out by the flatten/trim recipe the day/ line art came from.
import TheDayArt from '~/assets/day/the-day.svg';
import OurTipsArt from '~/assets/tips/our-tips.svg';
import RsvpArt from '~/assets/rsvp/rsvp.svg';
import FaqArt from '~/assets/faq/faq.svg';

interface Props {
  locale: Locale;
  current?: RouteKey;
}

const { locale, current } = Astro.props;
const t = useTranslations(locale);

/** `w`/`h` are the export's own viewBox, in the card's units. All four were
    set at the same size on the same card, so scaling them by one shared unit
    (`--nav-u`) keeps them in the proportions Canva drew them in — sizing each
    to a uniform height instead would make FAQ tower over OUR TIPS. */
interface Item {
  key: RouteKey;
  label: string;
  Art: typeof TheDayArt;
  w: number;
  h: number;
}

const items: Item[] = [
  { key: 'wedding', label: t('nav.wedding'), Art: TheDayArt, w: 124.25, h: 32.5 },
  { key: 'tips', label: t('nav.tips'), Art: OurTipsArt, w: 151.66, h: 30 },
  { key: 'rsvp', label: t('nav.rsvp'), Art: RsvpArt, w: 90.15, h: 29.77 },
  { key: 'faq', label: t('nav.faq'), Art: FaqArt, w: 52.1, h: 30.3 },
];
---

<nav class="nav" aria-label={t('nav.menu')}>
  <ul class="nav__list">
    {
      items.map((item) => (
        <li>
          <a
            class="nav__link"
            href={href(locale, item.key)}
            aria-current={item.key === current ? 'page' : undefined}
          >
            <span class="visually-hidden">{item.label}</span>
            <item.Art
              class="nav__art"
              aria-hidden="true"
              style={`--w:${item.w};--h:${item.h}`}
            />
          </a>
        </li>
      ))
    }
  </ul>

  <details class="nav__drawer" data-nav-drawer>
    {/*
      Morphing hamburger adapted from Uiverse.io by JulanDeAlb (MIT). The
      original drives it with a checkbox; here the state comes from <details>
      so the drawer keeps working without JS. One continuous path is drawn in
      by stroke-dasharray, so the bars don't rotate into an X — they're
      re-drawn as one.
    */}
    <summary class="nav__toggle" aria-label={t('nav.menu')}>
      <svg class="nav__icon" viewBox="0 0 32 32" aria-hidden="true">
        <path
          class="nav__line nav__line--morph"
          d="M27 10 13 10C10.8 10 9 8.2 9 6 9 3.5 10.8 2 13 2 15.2 2 17 3.8 17 6L17 26C17 28.2 18.8 30 21 30 23.2 30 25 28.2 25 26 25 23.8 23.2 22 21 22L7 22"
        ></path>
        <path class="nav__line" d="M7 16 27 16"></path>
      </svg>
    </summary>

    <div class="nav__backdrop" data-nav-backdrop aria-hidden="true"></div>

    <div class="nav__sheet" role="dialog" aria-modal="true" aria-label={t('nav.menu')}>
      <ul class="nav__sheet-list">
        {
          items.map((item, i) => (
            <li class="nav__sheet-item" style={`--i:${i}`}>
              <a
                class="nav__sheet-link"
                href={href(locale, item.key)}
                aria-current={item.key === current ? 'page' : undefined}
              >
                <span class="visually-hidden">{item.label}</span>
                <item.Art
                  class="nav__art"
                  aria-hidden="true"
                  style={`--w:${item.w};--h:${item.h}`}
                />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </details>
</nav>

{/*
  Progressive enhancement: smooth close, focus management, body lock,
  Escape-to-close, backdrop tap. Without this script the <details>
  still works — open/close just snaps instead of animating out.
  Inline so it executes before paint and doesn't block.
*/}
<script is:inline>
  (() => {
    const drawer = document.querySelector('[data-nav-drawer]');
    if (!drawer) return;

    const summary = drawer.querySelector('summary');
    const backdrop = drawer.querySelector('[data-nav-backdrop]');
    const sheet = drawer.querySelector('.nav__sheet');
    const firstLink = drawer.querySelector('.nav__sheet-link');
    const root = document.documentElement;

    let lastFocus = null;

    const close = () => {
      if (!drawer.open || drawer.dataset.closing) return;
      drawer.dataset.closing = '';
      const done = () => {
        delete drawer.dataset.closing;
        drawer.open = false;
        root.classList.remove('is-nav-open');
        if (lastFocus && lastFocus.focus) lastFocus.focus();
      };
      // Wait for the sheet's exit animation; fall back to a timeout so we
      // can never strand the drawer in a half-closed state.
      let settled = false;
      const onEnd = () => {
        if (settled) return;
        settled = true;
        sheet.removeEventListener('animationend', onEnd);
        done();
      };
      sheet.addEventListener('animationend', onEnd);
      setTimeout(onEnd, 320);
    };

    const open = () => {
      lastFocus = document.activeElement;
      root.classList.add('is-nav-open');
      // Defer focus to next frame so the sheet has rendered.
      requestAnimationFrame(() => firstLink && firstLink.focus({ preventScroll: true }));
    };

    summary.addEventListener('click', (e) => {
      if (drawer.open) {
        e.preventDefault();
        close();
      }
    });

    // <details> only fires `toggle` after open changes — use it to run
    // open-side side-effects without racing the click handler.
    drawer.addEventListener('toggle', () => {
      if (drawer.open) open();
    });

    backdrop.addEventListener('click', close);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drawer.open) {
        e.preventDefault();
        close();
      }
    });

    // Resize past the desktop breakpoint while the menu is open: the
    // drawer becomes display:none, so reset state instantly to avoid
    // stranding the body scroll-lock or focus.
    const mq = window.matchMedia('(min-width: 720px)');
    const onMq = (e) => {
      if (e.matches && drawer.open) {
        delete drawer.dataset.closing;
        drawer.open = false;
        root.classList.remove('is-nav-open');
      }
    };
    mq.addEventListener('change', onMq);
  })();
</script>

<style>
  .nav {
    display: contents;
  }

  /* —————————————————— Desktop list —————————————————— */
  .nav__list {
    display: none;
    align-items: center;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav__link {
    display: inline-block;
    padding: var(--space-2) var(--space-3);
    text-decoration: none;
    /* Same lagoon as the monogram beside it and the names in the hero. */
    color: var(--c-lagoon);
    /* One shared card unit for every label — see the `items` comment. */
    --nav-u: 0.5px;
    /* No hover or click affordance — the rule below carries the state. */
  }

  /* `text-decoration` can't mark the current page any more: the label is an
     atomic inline SVG, and browsers disagree about whether an underline is
     drawn under one. A border on the link is the same 2px of tide, drawn by
     the box instead of by the text. */
  .nav__link[aria-current='page'] {
    box-shadow: inset 0 -2px 0 var(--c-tide);
  }

  /* Scaled from the export's own viewBox so the four titles keep the sizes
     Canva drew them at relative to each other. */
  .nav__art {
    display: block;
    inline-size: calc(var(--nav-u) * var(--w));
    block-size: calc(var(--nav-u) * var(--h));
  }

  /* Keep keyboard users oriented — focus ring is preserved. */
  .nav__link:focus-visible {
    outline: 2px solid var(--c-tide);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }

  /* —————————————————— Toggle —————————————————— */
  .nav__drawer {
    position: relative;
  }

  /* Lift the whole drawer above the header while it's animating, so the
     sheet's gradient can flow continuously under the (transparent) header
     and the toggle stays the topmost interactive surface. */
  .nav__drawer[open],
  .nav__drawer[data-closing] {
    z-index: calc(var(--z-overlay) + 1);
  }

  .nav__toggle {
    position: relative;
    /* Above the sheet within the drawer's stacking context — keeps the
       button visually anchored "on top of" the menu it produces. */
    z-index: 3;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-pill);
    /* No disc at rest — the mark alone sits on the hero gradient. The 44×44
       box is still here, it just isn't painted until you touch it. */
    border: 0;
    background: transparent;
    cursor: pointer;
    list-style: none;
    color: var(--c-lagoon);
    transition:
      transform var(--dur-fast) var(--ease-out),
      background var(--dur-fast) var(--ease-out);
  }

  /* Tactile click feedback — quick squish on press, springs back. */
  .nav__toggle:active {
    transform: scale(0.96);
    transition-duration: 80ms;
  }
  .nav__toggle::-webkit-details-marker {
    display: none;
  }
  /* Hover dims the mark rather than painting a disc behind it. A hover fill
     reads as "the background came back" — and it sticks after a click, since
     the pointer is still over the control while the menu is open. */
  .nav__toggle:hover {
    opacity: 0.65;
  }
  .nav__toggle:focus-visible {
    outline: 2px solid var(--c-tide);
    outline-offset: 2px;
  }

  .nav__icon {
    display: block;
    width: 26px;
    height: 26px;
    transition: transform var(--dur-slow) var(--ease-in-out);
  }

  /* stroke-width 2 on a 32 viewBox lands at ~1.6px rendered — the weight of
     the hero's divider rules, rather than the snippet's chunkier 3. */
  .nav__line {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
    transition:
      stroke-dasharray var(--dur-slow) var(--ease-in-out),
      stroke-dashoffset var(--dur-slow) var(--ease-in-out);
  }

  /* Only 12 units of the long path are painted at rest — the top bar. */
  .nav__line--morph {
    stroke-dasharray: 12 63;
  }

  /* No fill when open either — the mark redrawing itself is the state change.
     Painting a disc behind it would say the same thing twice. */
  .nav__drawer[open] .nav__icon {
    transform: rotate(-45deg);
  }
  .nav__drawer[open] .nav__line--morph {
    stroke-dasharray: 20 300;
    stroke-dashoffset: -32.42;
  }

  /* Redraw back into bars while the panel is closing. Ordered after [open] so
     it wins on equal specificity. */
  .nav__drawer[data-closing] .nav__icon {
    transform: rotate(0);
  }
  .nav__drawer[data-closing] .nav__line--morph {
    stroke-dasharray: 12 63;
    stroke-dashoffset: 0;
  }

  /* —————————————————— Backdrop —————————————————— */
  /* An invisible click-catcher, not a scrim. The panel is small enough that
     dimming the whole page to introduce it would be the heavier gesture. */
  .nav__backdrop {
    position: fixed;
    inset: 0;
    z-index: 1;
  }

  /* —————————————————— Panel —————————————————— */
  /* A card hanging off the toggle, not a surface covering the page. Right edge
     lines up with the container's inline padding so it sits flush with the
     header content above it. */
  .nav__sheet {
    position: fixed;
    top: calc(var(--header-h) - var(--space-2));
    right: var(--space-6);
    z-index: 2;
    width: min(15rem, calc(100vw - var(--space-12)));
    padding: var(--space-2);
    /* Short gradient, low contrast — enough to give the card a light source,
       not enough to become a second background. */
    background: linear-gradient(
      165deg,
      var(--c-shell) 0%,
      color-mix(in srgb, var(--c-shell) 55%, var(--c-foam)) 100%
    );
    /* 20px outer − 8px padding = 12px inner, so the hover fill on a row is
       concentric with the card that holds it. */
    border-radius: var(--radius-lg);
    box-shadow:
      0 1px 2px color-mix(in srgb, var(--c-lagoon) 8%, transparent),
      0 12px 28px -8px color-mix(in srgb, var(--c-lagoon) 22%, transparent);
    /* Origin sits on the toggle's centre, not the card's corner: measured back
       from the container edge past the language pill (44px), the gap between
       the two controls, and half the toggle. The card visibly comes out of the
       hamburger rather than out of the pill next to it. */
    transform-origin: calc(100% - 44px - var(--space-2) - 22px) top;
    animation: nav-sheet-in var(--dur-base) var(--ease-out) both;
  }

  .nav__drawer[data-closing] .nav__sheet {
    animation: nav-sheet-out var(--dur-fast) var(--ease-in-out) both;
  }

  /* Grows out of the toggle's corner and settles downward. Scale + fade only,
     both compositable, so the drop stays smooth on a mid-range phone. */
  @keyframes nav-sheet-in {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes nav-sheet-out {
    from {
      opacity: 1;
      transform: none;
    }
    to {
      opacity: 0;
      transform: translateY(-4px) scale(0.98);
    }
  }

  .nav__sheet-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav__sheet-item {
    opacity: 0;
    transform: translateY(4px);
    animation: nav-item-in var(--dur-base) var(--ease-out) forwards;
    /* Runs under the card's own reveal so the rows arrive with it rather
       than after it — one gesture, not two. */
    animation-delay: calc(30ms + var(--i, 0) * 25ms);
  }
  /* Close is one quiet fade — exits should be softer than enters. */
  .nav__drawer[data-closing] .nav__sheet-item {
    animation: nav-item-out var(--dur-fast) var(--ease-in-out) forwards;
  }

  @keyframes nav-item-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes nav-item-out {
    from {
      opacity: 1;
      transform: translateY(0);
    }
    to {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  /* Rows in the card's own hand — the names, CURAÇAO and the monogram are all
     lagoon, so the menu is too. No numerals, no row arrows, no dividers: nav
     items aren't a sequence, and none of those marks exist on the card. */
  .nav__sheet-link {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--c-lagoon);
    /* Roomier than the header's row, but well short of the card's 200px of
       content width — at 1.1px the widest label (OUR TIPS, 151.66 units)
       ran nearly edge to edge and the rows read as headings, not menu
       items. 0.78px leaves the margin the card's own layout keeps. */
    --nav-u: 0.78px;
    transition:
      color var(--dur-fast) var(--ease-out),
      background var(--dur-fast) var(--ease-out);
  }
  /* States are carried by the fill, never by lightening the text: tide on this
     card measures 2.95:1, under the 4.5:1 floor. Lagoon stays put at 7.2:1 and
     the background does the signalling. */
  .nav__sheet-link:hover,
  .nav__sheet-link:focus-visible {
    background: color-mix(in srgb, var(--c-foam) 45%, transparent);
  }
  /* Current page holds the full foam fill — 6.2:1 with lagoon. */
  .nav__sheet-link[aria-current='page'] {
    background: var(--c-foam);
  }
  .nav__sheet-link:focus-visible {
    outline: 2px solid var(--c-tide);
    outline-offset: -2px;
  }

  /* —————————————————— Reduced motion —————————————————— */
  @media (prefers-reduced-motion: reduce) {
    .nav__backdrop,
    .nav__sheet,
    .nav__sheet-item,
    .nav__icon,
    .nav__line {
      animation: none !important;
      transition: none !important;
    }
    .nav__sheet-item {
      opacity: 1;
      transform: none;
    }
  }

  /* —————————————————— Breakpoints —————————————————— */
  @media (min-width: 720px) {
    .nav__list {
      display: flex;
    }
    .nav__drawer {
      display: none;
    }
  }
</style>
