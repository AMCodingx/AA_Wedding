---
import Nav from './Nav.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { useTranslations, type Locale } from '~/i18n';
import { href, type RouteKey } from '~/lib/url';
import Monogram from '~/assets/brand/monogram.svg';

interface Props {
  locale: Locale;
  current?: RouteKey;
}

const { locale, current } = Astro.props;
const t = useTranslations(locale);
---

<header class="header">
  <div class="container header__inner">
    <a class="header__brand" href={href(locale, 'home')} aria-label={t('site.title')}>
      <Monogram class="header__monogram" aria-hidden="true" />
    </a>
    <div class="header__right">
      <Nav locale={locale} current={current} />
      <LanguageSwitcher current={locale} routeKey={current} />
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    /* A shadow, not a border: a 1px border occupies flow, and on the home
       page that pixel is the difference between "fits exactly" and "scrolls". */
    box-shadow: 0 1px 0 var(--border);
    transition: box-shadow var(--dur-base) var(--ease-out);
  }

  /* The tint and blur live on a pseudo-element rather than on .header itself.
     An element with a backdrop-filter becomes the containing block for its
     `position: fixed` descendants — and for a *sticky* header that block is the
     un-stuck box at the top of the document, not the painted one. So the nav
     sheet and its backdrop anchored themselves however far the page had been
     scrolled, i.e. off the top of the screen. At scroll 0 the two coincided,
     which is why the menu only broke below the fold. The pseudo-element paints
     identically and has no descendants to trap. */
  .header::before {
    content: '';
    position: absolute;
    inset: 0;
    /* Behind the header's own content, still above the page scrolling under it. */
    z-index: -1;
    background: color-mix(in srgb, var(--bg) 90%, transparent);
    backdrop-filter: saturate(140%) blur(8px);
    -webkit-backdrop-filter: saturate(140%) blur(8px);
    transition: background var(--dur-base) var(--ease-out);
  }

  .header__inner {
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  /* Monogram alone — the "Our Wedding" wordmark was redundant next to a
     nav that already says what the site is, and it crowded the left edge.
     The accessible name lives on the anchor's aria-label. */
  .header__brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: var(--text);
    border-radius: var(--radius-sm);
    transition: opacity var(--dur-fast) var(--ease-out);
  }

  .header__brand:hover {
    opacity: 0.75;
  }

  .header__brand:focus-visible {
    outline: 2px solid var(--c-tide);
    outline-offset: 6px;
  }

  /* Outlined from the same Canva card as the hero names — the monogram is
     that wordmark in miniature, so it has to be the same hand, and the
     licensed face can't be self-hosted as a font. */
  .header__monogram {
    display: block;
    width: 3.25rem;
    height: auto;
    color: var(--c-lagoon);
  }

  .header__right {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  @media (max-width: 720px) {
    /* The card mockup: script monogram only, no chrome line. */
    .header {
      box-shadow: none;
    }
    .header__inner {
      gap: var(--space-2);
    }
    .header__right {
      gap: var(--space-2);
    }
    /* 15.45% of the card's width, matching the mockup's logo scale. */
    .header__monogram {
      width: 3.75rem;
    }
  }
</style>
