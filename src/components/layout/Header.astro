---
import Nav from './Nav.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { useTranslations, type Locale } from '~/i18n';
import { href, type RouteKey } from '~/lib/url';
import Monogram from '~/assets/brand/monogram.svg';

interface Props {
  locale: Locale;
  current?: RouteKey;
}

const { locale, current } = Astro.props;
const t = useTranslations(locale);
---

<header class="header">
  <div class="container header__inner">
    <a class="header__brand" href={href(locale, 'home')} aria-label={t('site.title')}>
      <Monogram class="header__monogram" aria-hidden="true" />
      <span class="header__title">{t('site.title')}</span>
    </a>
    <div class="header__right">
      <Nav locale={locale} current={current} />
      <LanguageSwitcher current={locale} routeKey={current} />
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: color-mix(in srgb, var(--bg) 90%, transparent);
    backdrop-filter: saturate(140%) blur(8px);
    -webkit-backdrop-filter: saturate(140%) blur(8px);
    /* A shadow, not a border: a 1px border occupies flow, and on the home
       page that pixel is the difference between "fits exactly" and "scrolls". */
    box-shadow: 0 1px 0 var(--border);
    transition:
      background var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out);
  }

  /* When the mobile nav sheet is open the sheet itself fills the header
     area with its gradient — let the chrome dissolve so the toggle and
     the menu read as one continuous surface. */
  :global(html.is-nav-open) .header {
    background: transparent;
    box-shadow: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .header__inner {
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .header__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: var(--text);
  }

  /* Outlined from the same Canva card as the hero names — the monogram is
     that wordmark in miniature, so it has to be the same hand, and the
     licensed face can't be self-hosted as a font. */
  .header__monogram {
    display: block;
    width: 3.25rem;
    height: auto;
    color: var(--c-lagoon);
  }

  .header__title {
    font-family: var(--font-display);
    font-size: var(--fs-base);
    font-weight: 500;
  }

  .header__right {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  @media (max-width: 720px) {
    /* The card mockup: script monogram only, no chrome line. */
    .header {
      box-shadow: none;
    }
    .header__inner {
      gap: var(--space-2);
    }
    .header__right {
      gap: var(--space-2);
    }
    /* 15.45% of the card's width, matching the mockup's logo scale. */
    .header__monogram {
      width: 3.75rem;
    }
    .header__title {
      display: none;
    }
  }
</style>
