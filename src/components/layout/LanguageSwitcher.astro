---
import Flag from './Flag.astro';
import { LOCALES, LOCALE_LABELS, type Locale } from '~/i18n/locales';
import { useTranslations } from '~/i18n';
import { ROUTES, type RouteKey, localePath } from '~/lib/url';

interface Props {
  current: Locale;
  /** The route key for the current page; used to switch to the equivalent in the other locale. */
  routeKey?: RouteKey;
}

const { current, routeKey } = Astro.props;
const t = useTranslations(current);

function localeHref(locale: Locale): string {
  if (routeKey) return localePath(locale, ROUTES[routeKey][locale]);
  return localePath(locale);
}

---

<details class="lang">
  {/*
    The flag is decorative (aria-hidden in Flag.astro), so the trigger carries
    the whole accessible name itself. It names the language in full rather than
    the code — with no visible text left, there's no visible string for it to
    match under WCAG 2.5.3, and "Language: English" is what a screen-reader
    user needs to hear.
  */}
  <summary
    class="lang__trigger"
    aria-label={`${t('lang.label')}: ${LOCALE_LABELS[current]}`}
  >
    <Flag locale={current} />
    <svg class="lang__caret" width="10" height="10" viewBox="0 0 20 20" aria-hidden="true">
      <path
        d="M5 8l5 5 5-5"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </summary>
  <ul class="lang__menu" role="menu">
    {
      LOCALES.map((locale, i) => (
        <li role="none" class="lang__row" style={`--i:${i}`}>
          <a
            role="menuitem"
            hreflang={locale}
            href={localeHref(locale)}
            aria-current={locale === current ? 'true' : undefined}
            class="lang__item"
          >
            <Flag locale={locale} size={19} />
            {LOCALE_LABELS[locale]}
          </a>
        </li>
      ))
    }
  </ul>
</details>

<style>
  .lang {
    position: relative;
  }

  /* No pill at rest, matching the nav toggle beside it — the two controls are
     marks on the hero, and the fill only shows up on contact. */
  .lang__trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    min-height: 44px;
    border-radius: var(--radius-pill);
    border: 0;
    background: transparent;
    cursor: pointer;
    list-style: none;
    color: var(--c-lagoon);
    transition:
      transform var(--dur-fast) var(--ease-out),
      background var(--dur-fast) var(--ease-out);
  }

  @media (max-width: 720px) {
    .lang__trigger {
      gap: 0;
      padding: 0;
      width: 44px;
      height: 44px;
    }
    .lang__caret {
      display: none;
    }
  }

  .lang__trigger::-webkit-details-marker {
    display: none;
  }

  /* Dim, don't fill — see the note on .nav__toggle:hover. */
  .lang__trigger:hover {
    opacity: 0.65;
  }

  .lang__trigger:focus-visible {
    outline: 2px solid var(--c-tide);
    outline-offset: 2px;
  }

  /* Same squish as the nav toggle. */
  .lang__trigger:active {
    transform: scale(0.96);
  }

  /* Inherits lagoon and steps back, rather than dropping to a grey that
     belongs to no part of the card. */
  .lang__caret {
    color: currentColor;
    opacity: 0.55;
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .lang[open] .lang__caret {
    transform: rotate(180deg);
  }

  /* Same card as the nav panel next door — surface, gradient, radius, shadow
     and drop are deliberately identical so the two header dropdowns read as
     one pair rather than two components that happen to be adjacent. */
  .lang__menu {
    position: absolute;
    top: calc(100% + var(--space-2));
    right: 0;
    min-width: 11rem;
    list-style: none;
    margin: 0;
    padding: var(--space-2);
    background: linear-gradient(
      165deg,
      var(--c-shell) 0%,
      color-mix(in srgb, var(--c-shell) 55%, var(--c-foam)) 100%
    );
    /* 20px outer − 8px padding = 12px inner, concentric with the row fill. */
    border-radius: var(--radius-lg);
    box-shadow:
      0 1px 2px color-mix(in srgb, var(--c-lagoon) 8%, transparent),
      0 12px 28px -8px color-mix(in srgb, var(--c-lagoon) 22%, transparent);
    z-index: var(--z-overlay);
    transform-origin: calc(100% - 22px) top;
    animation: lang-menu-in var(--dur-base) var(--ease-out) both;
  }

  .lang__row {
    opacity: 0;
    transform: translateY(4px);
    animation: lang-row-in var(--dur-base) var(--ease-out) forwards;
    animation-delay: calc(30ms + var(--i, 0) * 25ms);
  }

  @keyframes lang-menu-in {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes lang-row-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .lang__item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 44px;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--c-lagoon);
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 400;
    line-height: 1.2;
    transition:
      color var(--dur-fast) var(--ease-out),
      background var(--dur-fast) var(--ease-out);
  }

  /* States are carried by the fill, never by lightening the text: tide on this
     card measures 2.95:1, under the 4.5:1 floor. Lagoon stays put at 7.2:1 and
     the background does the signalling. */
  .lang__item:hover,
  .lang__item:focus-visible {
    background: color-mix(in srgb, var(--c-foam) 45%, transparent);
  }

  .lang__item:focus-visible {
    outline: 2px solid var(--c-tide);
    outline-offset: -2px;
  }

  /* Selected locale holds the full foam fill — 6.2:1 with lagoon. */
  .lang__item[aria-current='true'] {
    background: var(--c-foam);
  }
</style>
