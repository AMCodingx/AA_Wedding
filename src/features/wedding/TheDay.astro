---
// The whole page is one card, sized and laid out exactly like the hero:
// same gradient, same `--card-w` / `--card-h` model, same "never scrolls"
// contract. Geometry below is measured off the couple's Canva export
// (design/the-day-card.svg) in its own 310.5 × 672 units, then expressed
// as fractions of the card so it holds at any viewport.
//
// The title, the spine and the five icons ARE that export — Canva's
// "Feeling Passionate" is licensed and the line art is hand-drawn, so both
// ship as outlined vector exactly the way the hero's names do rather than
// being approximated in a webfont or in Icon.astro. All of it is flattened
// and Ramer-Douglas-Peucker'd at 0.08 card units (~0.13px at the largest
// card this site renders); re-derive from design/the-day-card.svg rather
// than hand-editing the path data.
import Title from '~/assets/day/the-day.svg';
import Spine from '~/assets/day/spine.svg';
// The welcome heart is the same drawing the hero's divider uses, so it lives
// in brand/ with the rest of the shared card artwork rather than twice here.
import Heart from '~/assets/brand/heart.svg';
import Rings from '~/assets/day/rings.svg';
import Glasses from '~/assets/day/glasses.svg';
import Cutlery from '~/assets/day/cutlery.svg';
import Disco from '~/assets/day/disco.svg';
import { useTranslations, type Locale } from '~/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

/** Side is the label's side; the artwork takes the other one. `w` is the
    drawing's width as a fraction of the card's width and `h` its height as
    a fraction of the card's height — measured off the export, so each piece
    lands at the scale it was drawn at instead of in a uniform icon box. */
const beats = [
  { key: 'welcome',  Art: Heart,   side: 'start', w: 0.095, h: 0.0406 },
  { key: 'ceremony', Art: Rings,   side: 'end',   w: 0.1208, h: 0.0458 },
  { key: 'cocktail', Art: Glasses, side: 'start', w: 0.1651, h: 0.0837 },
  { key: 'dinner',   Art: Cutlery, side: 'end',   w: 0.1208, h: 0.1031 },
  { key: 'party',    Art: Disco,   side: 'start', w: 0.2126, h: 0.1101 },
] as const;
---

<section class="day">
  <div class="day__bg" aria-hidden="true"></div>

  <div class="container day__inner">
    {/* Same shape as the hero's h1: the visible title is artwork, the
        readable — and translated — string sits in .visually-hidden for
        screen readers, SEO and the language switcher. The lettering itself
        stays English in every locale; the export has no DE DAG / EL DÍA. */}
    <h1 class="day__title">
      <span class="visually-hidden">{t('wedding.day.title')}</span>
      <Title class="day__title-art" aria-hidden="true" />
    </h1>

    <p class="day__intro">{t('wedding.day.intro')}</p>

    <p class="day__start">
      {t('wedding.day.start')}
      <span class="day__start-note">{t('wedding.day.startNote')}</span>
    </p>

    <ol class="timeline">
      <Spine class="timeline__spine" aria-hidden="true" />
      {
        beats.map(({ key, Art, side, w, h }, i) => (
          <li
            class:list={['timeline__beat', `timeline__beat--${side}`]}
            style={`--art-w:${w};--art-h:${h};--i:${i}`}
          >
            <span class="timeline__label">{t(`wedding.day.beat.${key}`)}</span>
            <Art class="timeline__art" aria-hidden="true" />
          </li>
        ))
      }
    </ol>

    <p class="day__note">{t('wedding.day.location')}</p>
  </div>
</section>

<style>
  .day {
    /* Same derivation as Hero.astro — see the comment there for why height
       leads and why the 37rem floor exists. Both pages are the same card. */
    --card-h: max(37rem, min(100dvh, 100vw / 0.4621));
    --card-w: calc(var(--card-h) * 0.4621);
    /* Clearance either side of the spine, for both labels and artwork. */
    --gutter: calc(var(--card-w) * 0.032);

    position: relative;
    overflow: hidden;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin-block-start: calc(-1 * var(--header-h));
    min-height: 100dvh;
    color: var(--c-lagoon);
  }

  /* Byte-for-byte the hero's gradient: the two pages are one continuous
     surface, so a second ramp here would read as a seam on navigation. */
  .day__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      180deg,
      var(--c-shell) 0%,
      color-mix(in srgb, var(--c-shell) 62%, var(--c-mist)) 28%,
      color-mix(in srgb, var(--c-foam) 60%, var(--c-shell)) 58%,
      var(--c-foam) 100%
    );
  }

  .day__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: var(--card-w);
    height: var(--card-h);
    max-width: none;
    /* The card wants 8.62%, but the header is a fixed 4.5rem and on a short
       phone that is the larger of the two — take whichever clears it. */
    padding-block: max(calc(var(--card-h) * 0.0862), calc(var(--header-h) + var(--space-2)))
      calc(var(--card-h) * 0.0336);
    padding-inline: 0;
  }

  .day__title {
    display: flex;
    justify-content: center;
    margin: 0;
    width: 100%;
    color: var(--c-lagoon);
  }

  /* 124.25 of the export's 310.5 — the artwork carries its own aspect, so
     the width is the only number this needs. */
  .day__title-art {
    display: block;
    width: 40%;
    height: auto;
  }

  .day__intro {
    width: 96%;
    /* Gaps are measured ink-to-ink on the export, so each one here is that
       figure minus the leading the line box below it already contributes. */
    margin-block-start: calc(var(--card-h) * 0.045);
    font-size: calc(var(--card-w) * 0.037);
    font-weight: 400;
    line-height: 1.31;
    color: var(--c-lagoon);
    text-wrap: pretty;
  }

  .day__start {
    display: flex;
    flex-direction: column;
    margin-block-start: calc(var(--card-h) * 0.044);
    font-size: calc(var(--card-w) * 0.0495);
    font-weight: 400;
    line-height: 1.2;
    color: var(--c-lagoon);
    text-wrap: balance;
  }

  .day__start-note {
    margin-block-start: calc(var(--card-h) * 0.006);
    font-size: calc(var(--card-w) * 0.0367);
  }

  /* ——— Timeline ——————————————————————————————————— */

  .timeline {
    position: relative;
    flex: 1;
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
    margin-block-start: calc(var(--card-h) * 0.032);
    display: flex;
    flex-direction: column;
    /* The beats are not evenly pitched in the mock — each row is as tall as
       its own drawing and the slack is shared out between them. */
    justify-content: space-between;
  }

  /* The brush stroke overhangs the first and last drawing by ~1% of the
     card at each end, which is what stops it reading as a plain rule. */
  .timeline__spine {
    position: absolute;
    inset-block: calc(var(--card-h) * -0.01);
    inset-inline-start: 50%;
    translate: -50%;
    width: calc(var(--card-w) * 0.0225);
    height: auto;
    color: var(--c-tide);
  }

  .timeline__beat {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    /* Twice the gutter, so each half's inner edge lands one gutter off
       centre and the spine sits in the middle of the gap. */
    column-gap: calc(var(--gutter) * 2);
    /* Card fractions, not percentages: the cells are grid tracks, so a %
       here would resolve against half a column instead of the card. */
    block-size: calc(var(--card-h) * var(--art-h));
  }

  .timeline__label {
    font-size: calc(var(--card-w) * 0.053);
    font-weight: 400;
    line-height: 1.15;
    color: var(--c-lagoon);
  }

  .timeline__art {
    inline-size: calc(var(--card-w) * var(--art-w));
    block-size: auto;
    max-width: none;
    color: var(--c-tide);
  }

  /* Label left of the spine, artwork right — both hugging the centre. */
  .timeline__beat--start {
    text-align: end;
  }
  .timeline__beat--start .timeline__label {
    justify-self: end;
  }
  .timeline__beat--start .timeline__art {
    justify-self: start;
  }

  .timeline__beat--end {
    text-align: start;
  }
  .timeline__beat--end .timeline__label {
    order: 2;
    justify-self: start;
  }
  .timeline__beat--end .timeline__art {
    order: 1;
    justify-self: end;
  }

  .day__note {
    width: 88%;
    margin-block-start: calc(var(--card-h) * 0.0693);
    font-size: calc(var(--card-w) * 0.037);
    font-weight: 400;
    line-height: 1.3;
    color: var(--c-lagoon);
    text-wrap: balance;
  }

  /* Staged reveal, same grammar as the hero: the day is read top to
     bottom, one beat at a time. One pass on load, no loops. */
  @media (prefers-reduced-motion: no-preference) {
    .day__title,
    .day__intro,
    .day__start,
    .timeline__spine,
    .timeline__beat,
    .day__note {
      opacity: 0;
      animation: day-rise var(--dur-slow) var(--ease-out) forwards;
    }

    .day__title { animation-delay: 50ms; }
    .day__intro { animation-delay: 150ms; }
    .day__start { animation-delay: 250ms; }
    .timeline__spine { animation-delay: 320ms; }
    .timeline__beat { animation-delay: calc(400ms + var(--i) * 90ms); }
    .day__note { animation-delay: 900ms; }

    @keyframes day-rise {
      from {
        opacity: 0;
        transform: translateY(14px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
  }
</style>
