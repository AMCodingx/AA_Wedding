---
import ImageCard from '~/components/ui/ImageCard.astro';
import Badge from '~/components/ui/Badge.astro';
import { TIPS, type TipCategory } from './tips.data';
import { useTranslations, type Locale } from '~/i18n';

// The page head is the fourth card in the set — same grammar as the hero,
// The day and the RSVP: outlined script title, the shared heart, then one
// centred statement. Geometry is measured off the couple's Canva export
// (design/our-tips-card.svg) in its own 310.5 × 672 units and expressed as
// fractions of the block's width, so it holds at any viewport.
//
// "OUR TIPS" is outlined "Feeling Passionate" for the same reason the hero's
// names are — the face is Canva-licensed and can't be self-hosted.
import Title from '~/assets/tips/our-tips.svg';
import Heart from '~/assets/brand/heart.svg';

// The four category marks are that same export's hand-drawn line art, not
// Icon.astro geometry. Food reuses The day's dinner drawing — it is literally
// the same cutlery, so it ships once.
//
// Imported raw and hoisted into one <symbol> sprite rather than dropped in as
// components: each drawing is 3–6 kB of path data and the page renders 48 of
// them (4 filter pills + 44 card badges). Inlined that is ~330 kB of HTML;
// as a sprite the drawings ship once and every mark after that is a 60-byte
// <use>.
import cutleryRaw from '~/assets/day/cutlery.svg?raw';
import sunRaw from '~/assets/tips/sun.svg?raw';
import cameraRaw from '~/assets/tips/camera.svg?raw';
import wavesRaw from '~/assets/tips/waves.svg?raw';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

/** `w`/`h` are the drawing's size in the export's own units. They are not
    normalised to a common icon box on purpose — the fork is drawn tall and
    the waves wide, and flattening that into a square would throw away the
    thing that makes them read as hand-drawn rather than as an icon set. */
const categories = [
  { id: 'food', art: cutleryRaw, w: 10.79, h: 20.05 },
  { id: 'activities', art: sunRaw, w: 14.98, h: 14.98 },
  { id: 'sights', art: cameraRaw, w: 19.56, h: 14.13 },
  { id: 'beach', art: wavesRaw, w: 27.72, h: 10.27 },
] as const satisfies readonly { id: TipCategory; art: string; w: number; h: number }[];

const metaFor = (id: TipCategory) => categories.find((c) => c.id === id)!;

/** Re-tag an exported drawing as a <symbol>. The exports are hand-authored
    single-root SVGs (see src/assets/tips/), so the root tag is the only thing
    that has to change; `fill` moves across with it because the paths inside
    rely on inheriting currentColor — that is what turns the mark white when
    its filter pill is selected. */
const markId = (id: TipCategory) => `tips-mark-${id}`;
const sprite = categories
  .map(({ id, art }) => {
    const viewBox = /viewBox="([^"]+)"/.exec(art)?.[1];
    if (!viewBox) throw new Error(`tips: ${id} artwork has no viewBox`);
    const inner = art.replace(/^\s*<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '');
    return `<symbol id="${markId(id)}" viewBox="${viewBox}" fill="currentColor">${inner}</symbol>`;
  })
  .join('');

// "All" view: mix categories together, ordered by name so it feels less rigid.
const allTips = [...TIPS].sort((a, b) => a.name.localeCompare(b.name));
---

<div class="tips">
  {/* Every hand-drawn mark on the page, once. Nothing here paints — <symbol>
      only renders where a <use> points at it. */}
  <svg class="tips__sprite" aria-hidden="true" focusable="false" set:html={sprite} />

  <header class="tips__intro">
    {/* Hero pattern: artwork for the eye, translated text for everything
        else. The lettering stays English in every locale — the export has
        no glyphs for ONZE TIPS or NUESTROS CONSEJOS. */}
    <h1 class="tips__title">
      <span class="visually-hidden">{t('tips.title')}</span>
      <Title class="tips__title-art" aria-hidden="true" />
    </h1>

    <Heart class="tips__heart" aria-hidden="true" />

    <p class="tips__statement">{t('tips.intro')}</p>
  </header>

  <fieldset class="tips__filters" aria-label={t('tips.filter.label')}>
    <legend class="visually-hidden">{t('tips.filter.label')}</legend>

    <input class="tips__radio" type="radio" id="tips-all" name="tips-filter" value="all" checked />
    <label class="tips__pill" for="tips-all"><span>{t('tips.filter.all')}</span></label>

    {categories.map(({ id, w, h }) => (
      <>
        <input class="tips__radio" type="radio" id={`tips-${id}`} name="tips-filter" value={id} />
        <label class="tips__pill" for={`tips-${id}`} style={`--art-w:${w};--art-h:${h}`}>
          <svg class="tips__mark tips__mark--pill" aria-hidden="true" focusable="false">
            <use href={`#${markId(id)}`} />
          </svg>
          <span>{t(`tips.filter.${id}`)}</span>
        </label>
      </>
    ))}
  </fieldset>

  <div class="tips__section" data-section="all">
    <ul class="tips__grid">
      {allTips.map((tip) => {
        const cat = metaFor(tip.category);
        return (
          <li>
            <ImageCard image={tip.image} alt={tip.name} title={tip.name}>
              <Badge slot="badge" tone="outline">
                <svg
                  class="tips__mark tips__mark--badge"
                  style={`--art-w:${cat.w};--art-h:${cat.h}`}
                  aria-hidden="true"
                  focusable="false"
                >
                  <use href={`#${markId(cat.id)}`} />
                </svg>
                {t(`tips.filter.${cat.id}`)}
              </Badge>
              <p>{tip.blurb[locale]}</p>
            </ImageCard>
          </li>
        );
      })}
    </ul>
  </div>

  {categories.map((cat) => {
    const tips = TIPS.filter((tip) => tip.category === cat.id);
    const catLabel = t(`tips.filter.${cat.id}`);
    return (
      <div class="tips__section" data-section={cat.id}>
        <ul class="tips__grid">
          {tips.map((tip) => (
            <li id={tip.id}>
              <ImageCard image={tip.image} alt={tip.name} title={tip.name}>
                <Badge slot="badge" tone="outline">
                  <svg
                    class="tips__mark tips__mark--badge"
                    style={`--art-w:${cat.w};--art-h:${cat.h}`}
                    aria-hidden="true"
                    focusable="false"
                  >
                    <use href={`#${markId(cat.id)}`} />
                  </svg>
                  {catLabel}
                </Badge>
                <p>{tip.blurb[locale]}</p>
              </ImageCard>
            </li>
          ))}
        </ul>
      </div>
    );
  })}
</div>

<style>
  /* Not display:none — a hidden sprite still has to be laid out for some
     engines to resolve <use> against it. Zero-sized and clipped instead. */
  .tips__sprite {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  /* One mark, two sizes. The px-per-export-unit scale is the only thing that
     changes, so the fork stays twice the waves' height in both places. */
  .tips__mark {
    flex: none;
    width: calc(var(--art-w) * var(--art-unit));
    height: calc(var(--art-h) * var(--art-unit));
  }

  /* 1.2px per unit lands the tallest drawing (the fork, 20.05 units) inside
     the pill's 40px floor once its padding is taken out. */
  .tips__mark--pill {
    --art-unit: 1.2px;
  }

  /* 0.68 against the badge's ~16px line box, for the same reason. */
  .tips__mark--badge {
    --art-unit: 0.68px;
  }

  /* ——— Head ——————————————————————————————————————————— */

  .tips__intro {
    /* The export is 310.5 units across and was drawn for a 414px phone, so
       every measurement below is a fraction of this. Capped at 34rem: past
       that the script title stops reading as a title and starts reading as
       a banner, and the statement's measure runs long. */
    --w: min(100vw, 34rem);

    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    /* The export hangs the title 3.78 units under the header, which is far
       tighter than a Section's own rhythm. Cancel the md top padding the
       page wraps this in and restore the export's gap — the page keeps that
       padding at the bottom, where the grid needs it. */
    margin-block-start: calc(var(--w) * 0.0122 - var(--space-12));
    /* 30 units of clear air before the filter row, less the leading the
       statement's own last line box already contributes. */
    margin-block-end: calc(var(--w) * 0.083);
    /* The export leaves 15.7 units — 20.9px on the phone it was drawn for —
       either side of the statement, and the container's own 24px inset is
       enough wider that "…most on Curaçao," stops fitting on line one and
       the whole paragraph rewraps. Give the head the card's full width back;
       the filter row and the grid keep the container inset. */
    margin-inline: calc(-1 * var(--space-6));
  }

  .tips__title {
    display: flex;
    justify-content: center;
    margin: 0;
    width: 100%;
    color: var(--c-lagoon);
  }

  /* 151.66 of the export's 310.5 — the artwork carries its own aspect. */
  .tips__title-art {
    display: block;
    width: calc(var(--w) * 0.4884);
    height: auto;
  }

  /* Same drawing the hero and RSVP dividers use, here on its own: the export
     hangs it under the title with nothing either side. 29.28 of 310.5, set
     18.35 units below the title's lowest ink. */
  .tips__heart {
    width: calc(var(--w) * 0.0943);
    height: auto;
    margin-block-start: calc(var(--w) * 0.0591);
    color: var(--c-tide);
  }

  /* Poppins 15 on a 20.9-unit baseline pitch in the export — the same spec
     the RSVP card sets, so the two pages speak in one voice. The gap is the
     export's 20.15 ink-to-ink less the ~6.7 units of half-leading and cap
     inset the first line box already puts above its own ink. */
  .tips__statement {
    margin-block-start: calc(var(--w) * 0.0433);
    /* The export's *ink* runs 15.7 units in from each edge; the text box it
       was set in is the 18px-a-side one the couple's Canva panel shows, and
       that ~4px is exactly what decides whether "…most on Curaçao," holds
       line one. Sized to the box, not to the ink. */
    width: calc(var(--w) * 0.913);
    max-width: 100%;
    font-size: calc(var(--w) * 0.0483);
    font-weight: 400;
    line-height: 1.393;
    color: var(--c-lagoon);
    /* Not `balance`: the export fills its first two lines and leaves a short
       third, and balancing redistributes that into three even lines the
       couple didn't sign off. `pretty` keeps those breaks and only guards
       against a one-word last line in the locales with longer copy. */
    text-wrap: pretty;
  }

  /* ——— Filters ———————————————————————————————————————— */

  .tips__filters {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    border: 0;
    margin: 0 0 var(--space-8);
    padding: 0;
  }

  .tips__radio {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }

  /* Same tracked-uppercase treatment as the hero CTA — these are the page's
     only buttons, so they wear the card system's button voice. */
  .tips__pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    white-space: nowrap;
    /* Tap target floor: the label alone is ~17px tall. */
    min-height: 40px;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-pill);
    /* Shallow water, not white. Lagoon on it is 5.51:1, and the pills now
       read as objects lying on the page rather than as holes cut in it. */
    background: var(--c-shallow);
    border: 1px solid color-mix(in srgb, var(--c-tide) 45%, transparent);
    box-shadow: var(--shadow-pill);
    cursor: pointer;
    font-family: var(--font-subtitle);
    font-size: var(--fs-xs);
    font-weight: var(--weight-subtitle);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--c-lagoon);
    transition:
      background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  /* The tracking adds a space after the *last* glyph too, which throws a
     centred label left by half of it. The hero pays this back with
     text-indent; a flex container ignores that, so pull it off the label. */
  .tips__pill > span {
    margin-inline-end: -0.18em;
  }

  .tips__pill:hover {
    background: color-mix(in srgb, var(--c-shallow) 62%, #fff);
    border-color: var(--c-tide);
    box-shadow: var(--shadow-md);
    transform: translateY(-1px);
  }

  .tips__radio:focus-visible + .tips__pill {
    outline: 2px solid var(--c-lagoon);
    outline-offset: 2px;
  }

  /* Same fill as the hero CTA: --c-tide is the brand teal but only reaches
     3.79:1 against white, and this is small type — --c-tide-deep is that
     colour darkened to 4.52:1, which clears AA. */
  .tips__radio:checked + .tips__pill {
    background: var(--c-tide-deep);
    color: var(--text-on-accent);
    border-color: var(--c-tide-deep);
    box-shadow: var(--shadow-cta);
    transform: translateY(-1px);
  }

  /* After the :checked rule — equal specificity, so the press wins. */
  .tips__pill:active {
    transform: scale(0.96);
  }

  @media (max-width: 599px) {
    .tips__pill {
      flex: 1 1 calc(50% - var(--space-2));
      padding-inline: var(--space-3);
    }

    .tips__pill[for='tips-all'] {
      flex-basis: 100%;
    }
  }

  /* Show / hide sections based on selected filter */
  .tips__section {
    display: none;
  }

  .tips:has(#tips-all:checked) .tips__section[data-section='all'],
  .tips:has(#tips-food:checked) .tips__section[data-section='food'],
  .tips:has(#tips-activities:checked) .tips__section[data-section='activities'],
  .tips:has(#tips-sights:checked) .tips__section[data-section='sights'],
  .tips:has(#tips-beach:checked) .tips__section[data-section='beach'] {
    display: block;
  }

  /* ——— Cards ————————————————————————————————————————— */

  /* Set on the grid rather than reached for at .card: Card.astro reads
     --card-bg off whatever ancestor supplies it. */
  .tips__grid {
    --card-bg: var(--c-shallow);

    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
    /* minmax(0,…), not 1fr: a bare 1fr track refuses to go under its
       content's min-content width, which is what let the long Dutch badge
       drag the whole grid past the viewport. */
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 600px) {
    .tips__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 900px) {
    .tips__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* Staged reveal, same grammar as the other three cards: the head is read
     top to bottom, then the filters arrive. One pass on load, no loops. */
  @media (prefers-reduced-motion: no-preference) {
    .tips__title,
    .tips__heart,
    .tips__statement,
    .tips__filters {
      opacity: 0;
      animation: tips-rise var(--dur-slow) var(--ease-out) forwards;
    }

    .tips__title { animation-delay: 50ms; }
    .tips__heart { animation-delay: 150ms; }
    .tips__statement { animation-delay: 250ms; }
    .tips__filters { animation-delay: 350ms; }

    @keyframes tips-rise {
      from {
        opacity: 0;
        transform: translateY(14px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
  }
</style>
