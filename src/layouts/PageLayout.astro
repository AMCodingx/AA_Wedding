---
import BaseLayout from './BaseLayout.astro';
import Header from '~/components/layout/Header.astro';
import Footer from '~/components/layout/Footer.astro';
import { useTranslations, type Locale } from '~/i18n';
import { type RouteKey } from '~/lib/url';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  routeKey?: RouteKey;
  preloadImage?: string;
  ogImage?: string;
  /** Home is a single-screen card that must not scroll, so it opts out —
      there is nowhere to scroll a footer into view. Content pages keep it. */
  showFooter?: boolean;
}

const {
  locale,
  title,
  description,
  routeKey,
  preloadImage,
  ogImage,
  showFooter = true,
} = Astro.props;
const t = useTranslations(locale);
---

<BaseLayout
  locale={locale}
  title={title}
  description={description}
  routeKey={routeKey}
  preloadImage={preloadImage}
  ogImage={ogImage}
>
  <a href="#main" class="skip-link">{t('nav.skip')}</a>
  <Header locale={locale} current={routeKey} />
  <main id="main">
    <slot />
  </main>
  {showFooter && <Footer locale={locale} />}
</BaseLayout>
